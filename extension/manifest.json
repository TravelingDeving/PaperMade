{
  "manifest_version": 3,
  "name": "PaperMade — Paper Trading Overlay",
  "version": "0.10.6",
  "description": "PaperMade v0.10.6 fixes seven-figure market-cap P&L tracking by using high-resolution live price/reference ratios when platform MC labels are rounded.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.usepapermade.com/*",
    "https://api.dexscreener.com/*",
    "https://papermade.devingtrader.workers.dev/*",
    "https://usepapermade.com/*",
    "https://axiom.trade/*",
    "https://*.axiom.trade/*",
    "https://lite-api.jup.ag/*",
    "https://papermade.xyz/*",
    "https://pump.fun/*",
    "https://*.pump.fun/*",
    "https://gmgn.ai/*",
    "https://*.gmgn.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*",
        "https://production.fomo.family/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://papermade.devingtrader.workers.dev/*",
        "https://usepapermade.com/*",
        "https://*.usepapermade.com/*",
        "https://papermade.xyz/*"
      ],
      "js": [
        "papermade-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PaperMade — Paper Trading Overlay"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bridge-page.js"
      ],
      "matches": [
        "https://papermade.devingtrader.workers.dev/*",
        "https://usepapermade.com/*",
        "https://*.usepapermade.com/*",
        "https://papermade.xyz/*"
      ]
    },
    {
      "resources": [
        "papermade-logo.png"
      ],
      "matches": [
        "https://fomo.family/*",
        "https://production.fomo.family/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ]
    }
  ]
}
